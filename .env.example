# Copy this file to .env and replace every change-me value before starting.

# Published ports
HTTP_PORT=80
HTTPS_PORT=443
DNS_PORT=53

# Caddy site addresses.
# Local HTTP:
CTFD_SITE_ADDRESS=http://localhost
PIHOLE_SITE_ADDRESS=http://pihole.localhost
# Public HTTPS example:
# CTFD_SITE_ADDRESS=ctf.example.com
# PIHOLE_SITE_ADDRESS=pihole.example.com

# Image pins
CADDY_VERSION=2.11.2-alpine
CTFD_VERSION=3.8.1
MARIADB_VERSION=10.11.13
REDIS_VERSION=7.4.8-alpine
PIHOLE_VERSION=2026.04.1

# CTFd
CTFD_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
CTFD_DB_ROOT_PASSWORD=change-me-root-db-password
CTFD_DB_PASSWORD=change-me-ctfd-db-password
CTFD_WORKERS=1
CTFD_REVERSE_PROXY=true

# Pi-hole
TZ=Australia/Brisbane
PIHOLE_WEBPASSWORD=change-me-pihole-admin-password
PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1
